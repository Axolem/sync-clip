<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SyncClipShell" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorPrimaryVariant">@color/signal_pressed</item>
        <item name="colorOnPrimary">@color/on_signal</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_muted</item>
        <item name="colorControlActivated">@color/signal</item>
    </style>

    <style name="SyncClip.SectionLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SyncClip.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/rule</item>
        <item name="hintTextColor">@color/ink_muted</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <style name="SyncClip.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/signal</item>
        <item name="android:textColor">@color/on_signal</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SyncClip.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/rule</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SyncClip.Button.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
